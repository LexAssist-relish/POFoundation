VITE_SUPABASE_URL=https://bsidelcowkrhyybggwxt.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server only (Vercel → Settings → Environment Variables). NEVER prefix with VITE_
SUPABASE_URL=https://bsidelcowkrhyybggwxt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Receipt reading (GPT-4o) — server only
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# WhatsApp alerts — server only. MSG91 is used when both MSG91 values are set.
MSG91_AUTH_KEY=your-msg91-authkey
MSG91_WHATSAPP_NUMBER=916282427364
# optional: shown in MSG91 template "code snippet"; leave unset if not shown
MSG91_WA_NAMESPACE=
WHATSAPP_TEMPLATE_LANG=en
APP_URL=https://your-app.vercel.app
